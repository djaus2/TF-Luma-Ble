<Window x:Class="BleWpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TF-Luna BLE Client" Height="640" Width="980" MinHeight="560" MinWidth="900">
    <Window.Resources>
        <Style x:Key="RaisedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#1B2733"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#405473" BlurRadius="6" ShadowDepth="2" Opacity="0.35" Direction="270"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="6" BorderThickness="1" BorderBrush="#8FA3BE">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#DCE6F2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="#C9DAF0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#B9CCE6" Offset="0"/>
                                            <GradientStop Color="#DCE6F2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5F7BA3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource RaisedButtonStyle}"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="BusyOverlay" Background="#66000000" CornerRadius="8" Panel.ZIndex="99" Visibility="Collapsed">
            <Grid>
                <Border Background="#F5F7FB" CornerRadius="10" Padding="18,12" BorderBrush="#CFD8E3" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock x:Name="BusySpinnerText" Text="⏳" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="BusyMessageText" Text="Connecting..." FontSize="15" FontWeight="SemiBold" Foreground="#1B2733" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="0" Padding="10" CornerRadius="6" Background="#F3F6FB" BorderBrush="#CFD8E3" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                    <TextBlock Text="TF-Luna BLE Service" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#A94442" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="StartTimerButton" Content="Start" Width="80" Height="34" Margin="0,0,8,0" IsEnabled="False" Click="StartTimerButton_Click"/>
                <Button Grid.Column="2" x:Name="ClearButton" Content="Clear" Width="90" Height="34" Margin="0,0,8,0" Click="ClearButton_Click"/>
                <Button Grid.Column="3" x:Name="ViewToggleButton" Content="Show log" Width="120" Height="34" Margin="0,0,8,0" Click="ViewToggleButton_Click"/>
                <Button Grid.Column="4" x:Name="ConnectButton" Content="Connect" Width="110" Height="34" Margin="0,0,8,0" IsEnabled="False" Click="ConnectButton_Click"/>
                <Button Grid.Column="5" x:Name="ScanButton" Content="Scan" Width="90" Height="34" Margin="0,0,8,0" Click="ScanButton_Click"/>
                <Button Grid.Column="6" x:Name="ExitButton" Content="Exit" Width="80" Height="34" Click="ExitButton_Click"/>
            </Grid>
        </Border>

        <Border x:Name="ModeSettingsBorder" Grid.Row="1" Margin="0,10,0,0" Padding="10" CornerRadius="6" Background="#FAFCFF" BorderBrush="#CFD8E3" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Mode" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="ModeCombo" VerticalAlignment="Center" SelectedIndex="1" IsEnabled="False" SelectionChanged="ModeCombo_SelectionChanged">
                    <ComboBoxItem Content="0 - Continuous" Tag="0"/>
                    <ComboBoxItem Content="1 - Threshold" Tag="1"/>
                    <ComboBoxItem Content="2 - Reserved" Tag="2"/>
                    <ComboBoxItem Content="3 - One Shot" Tag="3"/>
                </ComboBox>

                <StackPanel x:Name="GraphSettingsPanel" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Graph max (m)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="GraphMaxDistanceTextBox" Text="10" Width="60" Height="28" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Window" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="GraphWindowTextBox" Text="00:30" Width="60" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyGraphSettingsButton" Content="Apply" Width="78" Height="30" Click="ApplyGraphSettingsButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="GraphZoomOutButton" Content="Shrink" Width="70" Height="30" IsEnabled="False" Click="GraphZoomOutButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="GraphZoomInButton" Content="Expand" Width="70" Height="30" IsEnabled="False" Click="GraphZoomInButton_Click"/>
                </StackPanel>

                <Button Grid.Column="5" x:Name="CopyLogsButton" Content="Copy Logs" Width="100" Height="30" Margin="12,0,0,0" Click="CopyLogsButton_Click"/>
                <Button Grid.Column="6" x:Name="DebugToggleButton" Content="Set Pico Debug Off" Width="150" Height="30" Margin="8,0,0,0" IsEnabled="False" Click="DebugToggleButton_Click"/>

            </Grid>
        </Border>

        <Border x:Name="ThresholdSettingsBorder" Grid.Row="2" Margin="0,10,0,0" Padding="10" CornerRadius="6" Background="#F9FBFD" BorderBrush="#CFD8E3" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Threshold (mm)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="ThresholdTextBox" Text="100" Width="60" Height="28" IsEnabled="False" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="2" x:Name="SendThresholdButton" Content="Set Threshold" Width="136" Height="30" IsEnabled="False" Click="SendThresholdButton_Click" Margin="0,0,12,0"/>
                <CheckBox Grid.Column="3" x:Name="AutoStopAtMaxTimeCheckBox" Content="Stop at max graph time" IsChecked="True" VerticalAlignment="Center" IsEnabled="False" Margin="0,0,12,0"/>
            </Grid>
        </Border>

        <Border x:Name="RangeSettingsBorder" Grid.Row="2" Margin="0,10,0,0" Padding="10" CornerRadius="6" Background="#F9FBFD" BorderBrush="#CFD8E3" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
 
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Range (mm)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="RangeMinTextBox" Text="300" Width="60" Height="28" Margin="0,0,4,0" IsEnabled="False" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" x:Name="CaptureMinButton" Content="Auto Min" Width="80" Height="28" Margin="0,0,8,0" IsEnabled="False" Click="CaptureMinButton_Click"/>
                <TextBox Grid.Column="3" x:Name="RangeMaxTextBox" Text="2000" Width="60" Height="28" Margin="0,0,4,0" IsEnabled="False" VerticalContentAlignment="Center"/>
                <Button Grid.Column="4" x:Name="CaptureMaxButton" Content="Auto Max" Width="90" Height="28" Margin="0,0,8,0" IsEnabled="False" Click="CaptureMaxButton_Click"/>
                <Button Grid.Column="5" x:Name="SendRangeButton" Content="Manually Set Range" Width="120" Height="30" IsEnabled="False" Click="SendRangeButton_Click"/>
                <TextBlock Grid.Column="6" x:Name="RangeMaxTextBoxInfo" Text="Manual: Just enter and press.   Auto: Place object at distance and press." Foreground="Green" FontStyle="Italic" VerticalAlignment="Center" Margin="5,0,8,0"/>
            </Grid>
        </Border>

        <Border x:Name="DataRow" Grid.Row="3" Margin="0,10,0,0" Padding="10" CornerRadius="6" Background="#FFFFFF" BorderBrush="#CFD8E3" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Distance" FontSize="12" Foreground="#687889"/>
                    <TextBlock x:Name="DistanceText" Text="-- mm" FontSize="28" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Sensor Timestamp" FontSize="12" Foreground="#687889"/>
                    <TextBlock x:Name="SensorTimestampText" Text="-- ms" FontSize="28" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Elapsed From Start" FontSize="12" Foreground="#687889"/>
                    <TextBlock x:Name="ElapsedText" Text="--" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="GraphPanel" Grid.Row="5" Grid.RowSpan="2" Margin="0,10,0,0" Padding="8" CornerRadius="6" Background="#F9FBFD" BorderBrush="#CFD8E3" BorderThickness="1">
            <Grid>
                <ScrollViewer x:Name="GraphScrollViewer" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Visibility="Collapsed">
                    <Canvas x:Name="DistanceGraphCanvas" Background="#F3F7FB" HorizontalAlignment="Left" MouseLeftButtonDown="DistanceGraphCanvas_MouseLeftButtonDown"/>
                </ScrollViewer>
                <TextBlock x:Name="GraphPlaceholderText" Text="Graph hidden" Foreground="#687889" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="GraphClickTimeText" Text="Time: --:--" Foreground="#1B2733" Background="#FFF4CC" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>

                <Border x:Name="LogBorder" Background="#F9FBFD" Visibility="Visible">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Activity" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="13"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
